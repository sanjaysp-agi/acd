# LLM provider: "local" (deterministic fallback, default) or "bedrock".
# Bedrock access was verified working in this account/region -- see
# README "AWS Bedrock status".
PBRER_LLM_PROVIDER=local

# Only read if PBRER_LLM_PROVIDER=bedrock. Uses your LOCALLY CONFIGURED
# AWS credentials (aws configure / SSO) -- never put access keys here.
AWS_PROFILE=
AWS_REGION=eu-west-1
# Newer Claude models on Bedrock are ONLY available as cross-region
# inference profiles, not plain on-demand model IDs -- check with
# `aws bedrock list-inference-profiles --region <region>` if this 404s
# for your account. "claude-3-5-sonnet-20240620-v1:0" (the old default)
# is no longer in most accounts' model catalogs.
BEDROCK_MODEL_ID=eu.anthropic.claude-sonnet-4-5-20250929-v1:0

# Cost / safety controls
PBRER_MAX_TOOL_ITERATIONS=200
PBRER_MAX_INVOCATIONS_PER_RUN=40
# Must be large enough for the model to echo a prior tool result's array
# back as the next tool call's argument (e.g. a document's full heading
# list) -- too low silently truncates generation mid-tool-call with no
# error, leaving an empty/unusable argument. 16000 covers real PBRER
# documents with 100+ headings; raise further for unusually large inputs.
PBRER_MAX_OUTPUT_TOKENS=16000
PBRER_ENABLE_LLM_CACHE=true

# Calculation engine
PBRER_ROUNDING_DECIMALS=1
PBRER_LOW_CONFIDENCE_THRESHOLD=0.6
